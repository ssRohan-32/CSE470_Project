<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/refinery/dashboard' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>
    <div class="topbar">
      <div><h1 class="page-title">🏭 Refinery Dashboard</h1></div>
    </div>
    <% if (!refinery) { %>
    <div class="alert alert-warning">⚠️ No refinery registered under your account.</div>
    <% } else { %>
    <div class="stat-grid">
      <div class="stat-card"><div class="stat-icon">🏭</div><div class="stat-value"><%= refinery.name.split(' ')[0] %></div><div class="stat-label"><%= refinery.location %></div></div>
      <div class="stat-card success"><div class="stat-icon">📦</div><div class="stat-value"><%= pendingCount %></div><div class="stat-label">Pending Orders</div></div>
      <div class="stat-card warning"><div class="stat-icon">⭐</div><div class="stat-value"><%= refinery.trust_score.toFixed(1) %></div><div class="stat-label">Trust Score</div></div>
      <div class="stat-card"><div class="stat-icon">📅</div><div class="stat-value"><%= refinery.operational_days %></div><div class="stat-label">Operational Days</div></div>
    </div>
    <div class="card">
      <div class="card-header"><h3 class="card-title">📋 Recent Orders</h3><a href="/refinery/orders" class="btn btn-primary btn-sm">View All</a></div>
      <div class="table-wrapper">
        <table>
          <thead><tr><th>Date</th><th>Pump Owner</th><th>Fuel</th><th>Quantity</th><th>Status</th></tr></thead>
          <tbody>
            <% recentOrders.forEach(o => { %>
            <tr>
              <td class="text-sm text-muted"><%= new Date(o.created_at).toLocaleDateString() %></td>
              <td><%= o.pump_owner_name %></td>
              <td class="fuel-<%= o.fuel_type.toLowerCase() %>"><%= o.fuel_type %></td>
              <td><%= o.quantity.toLocaleString() %>L</td>
              <td><span class="badge <%= o.status==='pending'?'badge-warning':o.status==='accepted'?'badge-success':o.status==='rejected'?'badge-danger':'badge-info' %>"><%= o.status %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
