<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/pump/pricing' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">💰 Dynamic Pricing Engine</h1>
        <p class="page-subtitle">Feature 14 — Strategy Pattern: Standard / Holiday / Surge Pricing + Tax Engine</p>
      </div>
    </div>

    <!-- Strategy Cards (Pattern Demo) -->
    <div class="grid-3 mb-24">
      <% demoCalc.forEach((s, i) => { const colors = ['success','warning','danger']; %>
      <div class="card" style="border-top:3px solid var(--accent-<%= colors[i] %>);">
        <div class="flex-between mb-12">
          <h3 class="card-title"><%= s.name %> Pricing</h3>
          <span class="pattern-badge">Strategy</span>
        </div>
        <p class="text-muted text-sm mb-12"><%= s.description %></p>
        <div style="background:var(--bg-800); border-radius:8px; padding:12px; font-size:13px;">
          <div class="flex-between mb-4"><span class="text-muted">Base</span><span>৳<%= s.result.basePrice.toFixed(2) %>/L</span></div>
          <% if (s.result.multiplier) { %><div class="flex-between mb-4"><span class="text-muted">Multiplier</span><span class="text-warning"><%= s.result.multiplier %>×</span></div><% } %>
          <div class="flex-between mb-4"><span class="text-muted">Tax (15%)</span><span>৳<%= s.result.taxAmount.toFixed(2) %></span></div>
          <% if (s.result.surgeFee) { %><div class="flex-between mb-4"><span class="text-muted">Surge Fee</span><span class="text-danger">৳<%= s.result.surgeFee.toFixed(2) %></span></div><% } %>
          <hr style="border-color:var(--border-color); margin:8px 0;">
          <div class="flex-between"><span class="font-bold">Final (30L)</span><span class="font-bold text-<%= colors[i] %>">৳<%= s.result.finalPrice.toFixed(2) %></span></div>
        </div>
        <form action="/pump/pricing/activate" method="POST" class="mt-12">
          <input type="hidden" name="strategy" value="<%= s.name %>">
          <button type="submit" class="btn btn-<%= colors[i] %> btn-sm w-full" style="justify-content:center;">
            Activate <%= s.name %>
          </button>
        </form>
      </div>
      <% }) %>
    </div>

    <!-- Live Calculator -->
    <div class="grid-2 mb-24">
      <div class="card">
        <div class="card-header"><h3 class="card-title">🧮 Live Price Calculator</h3></div>
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label">Strategy</label>
            <select id="calc-strategy" class="form-control" onchange="recalculate()">
              <option>Standard</option><option>Holiday</option><option>Surge</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Base Price (৳/L)</label>
            <input type="number" id="calc-price" class="form-control" value="1.35" step="0.01" oninput="recalculate()">
          </div>
          <div class="form-group">
            <label class="form-label">Quantity (L)</label>
            <input type="number" id="calc-qty" class="form-control" value="50" oninput="recalculate()">
          </div>
          <div class="form-group">
            <label class="form-label">Tax Rate (%)</label>
            <input type="number" id="calc-tax" class="form-control" value="15" step="1" oninput="recalculate()">
          </div>
        </div>
        <div id="calc-result" style="background:var(--bg-800); border-radius:8px; padding:16px;"></div>
      </div>

      <!-- Add/Update Pricing Rule -->
      <div class="card">
        <div class="card-header"><h3 class="card-title">⚙️ Configure Pricing Rule</h3></div>
        <form action="/pump/pricing" method="POST">
          <div class="form-group">
            <label class="form-label">Strategy</label>
            <select name="strategy" class="form-control" required>
              <option>Standard</option><option>Holiday</option><option>Surge</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Fuel Type</label>
            <select name="fuel_type" class="form-control" required>
              <% fuelTypes.forEach(f => { %><option><%= f %></option><% }) %>
            </select>
          </div>
          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">Base Price</label>
              <input type="number" name="base_price" class="form-control" value="1.35" step="0.01" required>
            </div>
            <div class="form-group">
              <label class="form-label">Multiplier</label>
              <input type="number" name="multiplier" class="form-control" value="1.0" step="0.01" required>
            </div>
            <div class="form-group">
              <label class="form-label">Tax Rate</label>
              <input type="number" name="tax_rate" class="form-control" value="0.15" step="0.01" required>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-full" style="justify-content:center;">💾 Save Rule</button>
        </form>
      </div>
    </div>

    <!-- Current Rules Table -->
    <div class="card">
      <div class="card-header"><h3 class="card-title">📋 Configured Pricing Rules</h3></div>
      <div class="table-wrapper">
        <table>
          <thead><tr><th>Strategy</th><th>Fuel Type</th><th>Base</th><th>Multiplier</th><th>Tax</th><th>Final/L</th><th>Status</th></tr></thead>
          <tbody>
            <% rules.forEach(r => { const final = r.base_price * r.multiplier * (1 + r.tax_rate); %>
            <tr>
              <td><span class="badge badge-<%= r.strategy==='Standard'?'success':r.strategy==='Holiday'?'warning':'danger' %>"><%= r.strategy %></span></td>
              <td class="fuel-<%= r.fuel_type.toLowerCase() %> font-semibold"><%= r.fuel_type %></td>
              <td>৳<%= r.base_price.toFixed(2) %></td>
              <td><%= r.multiplier.toFixed(2) %>×</td>
              <td><%= (r.tax_rate*100).toFixed(0) %>%</td>
              <td class="font-bold text-success">৳<%= final.toFixed(3) %></td>
              <td><span class="badge <%= r.is_active ? 'badge-success' : 'badge-muted' %>"><%= r.is_active ? '✅ Active' : 'Inactive' %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>
<script>
  function recalculate() {
    const strategy = document.getElementById('calc-strategy').value;
    const base = parseFloat(document.getElementById('calc-price').value) || 0;
    const qty = parseFloat(document.getElementById('calc-qty').value) || 0;
    const taxRate = parseFloat(document.getElementById('calc-tax').value) / 100 || 0.15;
    const multipliers = { Standard: 1.0, Holiday: 1.12, Surge: 1.25 };
    const mult = multipliers[strategy] || 1;
    const adjusted = base * mult;
    const subtotal = adjusted * qty;
    const tax = subtotal * taxRate;
    const surge = strategy === 'Surge' ? subtotal * 0.03 : 0;
    const total = subtotal + tax + surge;

    document.getElementById('calc-result').innerHTML = `
      <div class="flex-between mb-6"><span class="text-muted">Adjusted Price</span><span>৳${adjusted.toFixed(4)}/L</span></div>
      <div class="flex-between mb-6"><span class="text-muted">Subtotal (${qty}L)</span><span>৳${subtotal.toFixed(2)}</span></div>
      <div class="flex-between mb-6"><span class="text-muted">Tax (${(taxRate*100).toFixed(0)}%)</span><span>৳${tax.toFixed(2)}</span></div>
      ${surge ? `<div class="flex-between mb-6"><span class="text-muted">Surge Fee</span><span class="text-danger">৳${surge.toFixed(2)}</span></div>` : ''}
      <hr style="border-color:var(--border-color); margin:8px 0;">
      <div class="flex-between"><span class="font-bold">TOTAL</span><span class="font-bold text-success" style="font-size:20px;">৳${total.toFixed(2)}</span></div>
    `;
  }
  recalculate();
</script>
</body>
</html>
