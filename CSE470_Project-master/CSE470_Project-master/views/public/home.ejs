<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Find nearby fuel stations with live availability and distance-based routing.">
  <link rel="stylesheet" href="/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/home' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">🗺️ Find Fuel Stations</h1>
        <p class="page-subtitle">Feature 1 — Custom Routing & Filtering Service | <span class="pattern-badge">🧮 Haversine Distance Algorithm</span></p>
      </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-24">
      <form method="GET" action="/home" id="filter-form">
        <div style="display:grid; grid-template-columns:2fr 1fr 1fr 1fr auto; gap:12px; align-items:end;">
          <div class="form-group mb-0">
            <label class="form-label">Fuel Type</label>
            <select name="fuelType" class="form-control" id="fuelType">
              <option value="">All Types</option>
              <% fuelTypes.forEach(f => { %>
                <option value="<%= f %>" <%= fuelType === f ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group mb-0">
            <label class="form-label">Latitude</label>
            <input type="number" name="lat" class="form-control" value="<%= userLat %>" step="0.0001" id="lat">
          </div>
          <div class="form-group mb-0">
            <label class="form-label">Longitude</label>
            <input type="number" name="lon" class="form-control" value="<%= userLon %>" step="0.0001" id="lon">
          </div>
          <div class="form-group mb-0">
            <label class="form-label">Max Dist (km)</label>
            <input type="number" name="maxDist" class="form-control" value="<%= maxDist %>" min="1" max="200">
          </div>
          <button type="submit" class="btn btn-primary">🔍 Search</button>
        </div>
      </form>
    </div>

    <% if (pumps.length === 0) { %>
      <div class="empty-state">
        <div class="emoji">🏜️</div>
        <h3>No stations found</h3>
        <p>Try increasing max distance or changing the fuel type filter.</p>
      </div>
    <% } else { %>

    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
      <span class="text-secondary text-sm"><%= pumps.length %> station(s) found</span>
      <% if (userLat && userLng) { %>
      <span class="badge badge-info">🧮 Sorted by Distance</span>
      <% } else { %>
      <span class="badge badge-info">Showing All Stations</span>
      <% } %>
    </div>

    <div style="display:grid; gap:16px;">
      <% pumps.forEach((pump, idx) => { %>
      <%
        const isMaintenance = pump.status === 'maintenance';
        const isInactive    = pump.status === 'inactive';
        const borderColor   = isMaintenance ? 'var(--accent-warning)' : isInactive ? 'var(--accent-danger)' : 'var(--accent-success)';
        const badgeClass    = isMaintenance ? 'badge-warning' : isInactive ? 'badge-danger' : 'badge-success';
        const dotColor      = isMaintenance ? 'var(--accent-warning)' : isInactive ? 'var(--accent-danger)' : 'var(--accent-success)';
        const statusLabel   = isMaintenance ? '🔧 Maintenance' : isInactive ? '❌ Inactive' : '✅ Active';
      %>
      <div class="card" style="border-left: 4px solid <%= borderColor %>;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
          <div>
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
              <span style="font-size:18px; font-weight:700; color:var(--text-muted);">#<%= idx + 1 %></span>
              <h3 style="font-size:17px;"><%= pump.name %></h3>
              <span class="badge <%= badgeClass %>">
                <span class="pulse-dot" style="background:<%= dotColor %>"></span>
                <%= statusLabel %>
              </span>
            </div>
            <p class="text-secondary text-sm">📍 <%= pump.location %></p>
            <% if (isMaintenance) { %>
            <p class="text-sm mt-8" style="color:var(--accent-warning);">⚠️ This station is temporarily under maintenance. Fuel availability shown for reference.</p>
            <% } %>
          </div>
          <% if (pump.distance !== undefined) { %>
          <div style="text-align:right;">
            <div style="font-size:28px; font-weight:800; color:var(--accent-secondary);"><%= pump.distance.toFixed(1) %> km</div>
            <div class="text-muted text-xs">from your location</div>
          </div>
          <% } %>
        </div>

        <% if (pump.inventory && pump.inventory.length) { %>
        <div style="margin-top:16px; display:flex; flex-wrap:wrap; gap:10px;">
          <% pump.inventory.forEach(fuel => {
            const fillPct = fuel.capacity > 0 ? Math.min(100, (fuel.quantity / fuel.capacity) * 100) : 0;
            const icons = { Octane:'🔶', Diesel:'⚫', Petrol:'🟢', EV:'⚡' };
            const icon  = icons[fuel.fuel_type] || '⛽';
            const stockColor = fillPct > 50 ? 'var(--accent-success)' : fillPct > 20 ? 'var(--accent-warning)' : 'var(--accent-danger)';
          %>
          <div style="background:var(--bg-800); padding:10px 14px; border-radius:8px; min-width:120px;">
            <div style="font-size:12px; color:var(--text-muted); margin-bottom:6px;"><%= icon %> <%= fuel.fuel_type %></div>
            <div style="background:var(--bg-700); border-radius:4px; height:6px; margin-bottom:4px;">
              <div style="width:<%= fillPct.toFixed(1) %>%; height:100%; background:<%= stockColor %>; border-radius:4px; transition:width 0.3s;"></div>
            </div>
            <div style="font-size:12px; color:var(--text-secondary);"><%= fuel.quantity.toFixed(0) %>L &nbsp;·&nbsp; ৳<%= fuel.price_per_liter ? fuel.price_per_liter.toFixed(2) : '—' %>/L</div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p class="text-muted text-sm mt-16">No fuel inventory data available.</p>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>

  </main>
</div>
<script src="/js/charts.js"></script>
</body>
</html>
