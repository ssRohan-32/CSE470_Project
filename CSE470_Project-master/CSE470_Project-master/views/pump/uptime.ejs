<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/pump/uptime' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">🔄 Dynamic Uptime Controller</h1>
        <p class="page-subtitle">Feature 13 — Station Mode Toggle with System-Wide Status Propagation</p>
      </div>
    </div>

    <div class="alert alert-info mb-24">
      <span>📢</span>
      <div>
        Toggling a station to <strong>Maintenance Mode</strong> immediately marks it
        <strong>"Unavailable"</strong> across all public maps, routing services, and refinery dashboards.
      </div>
    </div>

    <div style="display:grid; gap:20px;">
      <% pumps.forEach(pump => { %>
      <div class="card" style="border-left: 4px solid <%=
        pump.status==='active' ? 'var(--accent-success)' :
        pump.status==='maintenance' ? 'var(--accent-warning)' : 'var(--accent-danger)'
      %>;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
          <div>
            <div class="flex-center gap-12 mb-8">
              <h3 style="font-size:18px;"><%= pump.name %></h3>
              <span class="badge badge-<%= pump.status==='active'?'success':pump.status==='maintenance'?'warning':'danger' %>">
                <span class="pulse-dot" style="background:<%=pump.status==='active'?'var(--accent-success)':'var(--accent-warning)'%>"></span>
                <%= pump.status.toUpperCase() %>
              </span>
            </div>
            <p class="text-secondary text-sm">📍 <%= pump.location %></p>
          </div>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <% if (pump.status !== 'active') { %>
            <form action="/pump/uptime/toggle" method="POST">
              <input type="hidden" name="pumpId" value="<%= pump.id %>">
              <input type="hidden" name="status" value="active">
              <button type="submit" class="btn btn-success">✅ Set Active</button>
            </form>
            <% } %>
            <% if (pump.status !== 'maintenance') { %>
            <form action="/pump/uptime/toggle" method="POST" onsubmit="return confirm('Switch to maintenance mode? This will hide the station from all maps.')">
              <input type="hidden" name="pumpId" value="<%= pump.id %>">
              <input type="hidden" name="status" value="maintenance">
              <button type="submit" class="btn btn-warning">🔧 Maintenance Mode</button>
            </form>
            <% } %>
            <% if (pump.status !== 'inactive') { %>
            <form action="/pump/uptime/toggle" method="POST" onsubmit="return confirm('Mark station as inactive?')">
              <input type="hidden" name="pumpId" value="<%= pump.id %>">
              <input type="hidden" name="status" value="inactive">
              <button type="submit" class="btn btn-danger btn-sm">❌ Mark Inactive</button>
            </form>
            <% } %>
          </div>
        </div>

        <div style="margin-top:16px; display:flex; gap:16px; flex-wrap:wrap;">
          <div style="background:var(--bg-800); padding:10px 16px; border-radius:8px; text-align:center;">
            <div class="text-muted text-xs">Effect on Routing</div>
            <div class="font-semibold text-sm mt-4 <%= pump.status==='active'?'text-success':'text-danger' %>">
              <%= pump.status==='active' ? '✅ Visible to customers' : '❌ Hidden from all maps' %>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

  </main>
</div>
</body>
</html>
