<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/refinery/orders' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">📋 Supply Order Management</h1>
        <p class="page-subtitle">Features 8 & 9 — B2B Order State Machine + Inter-Refinery Referral Engine</p>
      </div>
    </div>

    <!-- Status Summary -->
    <div class="stat-grid mb-24">
      <% const statusConfig = {pending:{color:'warning',icon:'⏳'}, accepted:{color:'success',icon:'✅'}, rejected:{color:'danger',icon:'❌'}, referred:{color:'info',icon:'↩️'}, delivered:{color:'purple',icon:'📦'}}; %>
      <% Object.entries(statusCounts).forEach(([status, count]) => { const cfg = statusConfig[status]||{color:'muted',icon:'•'}; %>
      <div class="stat-card <%= cfg.color %>">
        <div class="stat-icon"><%= cfg.icon %></div>
        <div class="stat-value"><%= count %></div>
        <div class="stat-label"><%= status.charAt(0).toUpperCase()+status.slice(1) %></div>
      </div>
      <% }) %>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">📜 All Supply Orders</h3></div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr><th>Date</th><th>Pump Owner</th><th>Fuel Type</th><th>Quantity</th><th>Value</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% orders.forEach(o => { %>
            <tr>
              <td class="text-sm text-muted"><%= new Date(o.created_at).toLocaleDateString() %></td>
              <td><strong><%= o.pump_owner_name %></strong></td>
              <td class="fuel-<%= o.fuel_type.toLowerCase() %> font-semibold"><%= o.fuel_type %></td>
              <td><%= o.quantity.toLocaleString() %>L</td>
              <td class="font-bold">৳<%= o.total_cost.toLocaleString() %></td>
              <td><span class="badge badge-<%= o.status==='pending'?'warning':o.status==='accepted'?'success':o.status==='rejected'?'danger':o.status==='referred'?'info':'purple' %>"><%= o.status %></span></td>
              <td>
                <% if (o.status === 'pending') { %>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                  <form action="/refinery/orders/status" method="POST" style="display:inline;">
                    <input type="hidden" name="orderId" value="<%= o.id %>">
                    <input type="hidden" name="status" value="accepted">
                    <button class="btn btn-success btn-sm">✅ Accept</button>
                  </form>
                  <form action="/refinery/orders/status" method="POST" style="display:inline;">
                    <input type="hidden" name="orderId" value="<%= o.id %>">
                    <input type="hidden" name="status" value="rejected">
                    <button class="btn btn-danger btn-sm">❌ Reject</button>
                  </form>
                  <% if (refinery.is_at_capacity || allRefineries.length > 0) { %>
                  <button class="btn btn-ghost btn-sm" onclick="showReferModal(<%= o.id %>)">↩️ Refer</button>
                  <% } %>
                </div>
                <% } else if (o.status === 'accepted') { %>
                <form action="/refinery/orders/status" method="POST" style="display:inline;">
                  <input type="hidden" name="orderId" value="<%= o.id %>">
                  <input type="hidden" name="status" value="delivered">
                  <button class="btn btn-primary btn-sm">📦 Mark Delivered</button>
                </form>
                <% } else { %>
                <span class="text-muted text-sm">No actions</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Feature 9: Referral Modal -->
    <div id="refer-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:200; align-items:center; justify-content:center;">
      <div class="card" style="max-width:420px; width:90%; position:relative;">
        <div class="card-header">
          <h3 class="card-title">↩️ Inter-Refinery Referral</h3>
          <button onclick="document.getElementById('refer-modal').style.display='none'" class="btn btn-ghost btn-sm">✕</button>
        </div>
        <p class="text-secondary text-sm mb-16">Route this order to a partner refinery with available capacity:</p>
        <form action="/refinery/orders/refer" method="POST">
          <input type="hidden" name="orderId" id="refer-order-id">
          <div class="form-group">
            <label class="form-label">Select Partner Refinery</label>
            <select name="targetRefineryId" class="form-control" required>
              <% allRefineries.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %> (<%= r.location %>) — Cap: <%= (r.capacity/1000).toFixed(0) %>k L</option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-full" style="justify-content:center;">↩️ Refer Order</button>
        </form>
      </div>
    </div>

  </main>
</div>
<script>
  function showReferModal(orderId) {
    document.getElementById('refer-order-id').value = orderId;
    document.getElementById('refer-modal').style.display = 'flex';
  }
</script>
</body>
</html>
