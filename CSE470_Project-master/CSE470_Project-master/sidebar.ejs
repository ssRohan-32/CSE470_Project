<%
/**
 * views/partials/sidebar.ejs
 * Role-based navigation — Module 1 + Module 2 only
 */
const role = user ? user.role : null;
const path = locals.currentPath || '';
%>

<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">⛽</div>
    <div class="logo-title">NAFAS</div>
    <div class="logo-subtitle">Fuel Station System</div>
  </div>

  <% if (user) { %>
  <div class="sidebar-user">
    <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <div class="user-name"><%= user.name %></div>
      <div class="user-role"><%= user.role.replace('_', ' ') %></div>
    </div>
  </div>
  <% } %>

  <nav class="sidebar-nav">

    <!-- Public — always visible (Module 1: F1, F2) -->
    <span class="nav-section-label">Public</span>
    <a href="/home" class="nav-item <%= path === '/home' ? 'active' : '' %>">
      <span class="nav-icon">🗺️</span> Find Stations
    </a>
    <a href="/inventory" class="nav-item <%= path === '/inventory' ? 'active' : '' %>">
      <span class="nav-icon">📊</span> Fuel Inventory
    </a>

    <!-- Customer (Module 1: F5 · Module 2: F6) -->
    <% if (role === 'customer') { %>
    <hr class="divider">
    <span class="nav-section-label">Customer</span>
    <a href="/customer/wallet" class="nav-item <%= path.startsWith('/customer/wallet') ? 'active' : '' %>">
      <span class="nav-icon">💳</span> Digital Wallet <small style="opacity:.6;font-size:10px;">F5</small>
    </a>
    <a href="/customer/payment" class="nav-item <%= path.startsWith('/customer/payment') ? 'active' : '' %>">
      <span class="nav-icon">⛽</span> Buy Fuel <small style="opacity:.6;font-size:10px;">F6</small>
    </a>
    <% } %>

    <!-- Pump Owner (Module 1: F13 · Module 2: F7, F9) -->
    <% if (role === 'pump_owner') { %>
    <hr class="divider">
    <span class="nav-section-label">Pump Owner</span>
    <a href="/pump/dashboard" class="nav-item <%= path === '/pump/dashboard' ? 'active' : '' %>">
      <span class="nav-icon">🏪</span> Dashboard
    </a>
    <a href="/pump/uptime" class="nav-item <%= path.startsWith('/pump/uptime') ? 'active' : '' %>">
      <span class="nav-icon">🔄</span> Maintenance Mode <small style="opacity:.6;font-size:10px;">F13</small>
    </a>
    <a href="/pump/procurement" class="nav-item <%= path.startsWith('/pump/procurement') ? 'active' : '' %>">
      <span class="nav-icon">📦</span> Procurement Portal <small style="opacity:.6;font-size:10px;">F9</small>
    </a>
    <a href="/pump/pricing" class="nav-item <%= path.startsWith('/pump/pricing') ? 'active' : '' %>">
      <span class="nav-icon">💰</span> Dynamic Pricing <small style="opacity:.6;font-size:10px;">F7</small>
    </a>
    <% } %>

    <!-- Refinery Owner (Module 2: F8, F10) -->
    <% if (role === 'refinery_owner') { %>
    <hr class="divider">
    <span class="nav-section-label">Refinery Owner</span>
    <a href="/refinery/dashboard" class="nav-item <%= path === '/refinery/dashboard' ? 'active' : '' %>">
      <span class="nav-icon">🏭</span> Refinery Dashboard
    </a>
    <a href="/refinery/orders" class="nav-item <%= path.startsWith('/refinery/orders') ? 'active' : '' %>">
      <span class="nav-icon">📋</span> Supply Orders <small style="opacity:.6;font-size:10px;">F8·F10</small>
    </a>
    <% } %>

    <!-- Superadmin (Module 1: F17) -->
    <% if (role === 'superadmin') { %>
    <hr class="divider">
    <span class="nav-section-label">Superadmin</span>
    <a href="/admin/ledger" class="nav-item <%= path.startsWith('/admin/ledger') ? 'active' : '' %>">
      <span class="nav-icon">📒</span> Transaction Ledger <small style="opacity:.6;font-size:10px;">F17</small>
    </a>
    <% } %>

  </nav>

  <div class="sidebar-footer">
    <% if (user) { %>
    <a href="/logout" class="btn btn-ghost w-full" style="justify-content:center;">
      🚪 Logout
    </a>
    <% } else { %>
    <a href="/login" class="btn btn-primary w-full" style="justify-content:center;">Login</a>
    <% } %>
  </div>
</aside>
