<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/pump/dashboard' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">🏪 My Fuel Stations</h1>
        <p class="page-subtitle">NAFAS Module 1 — Manage your stations and toggle maintenance mode</p>
      </div>
    </div>

    <div class="stat-grid mb-24">
      <div class="stat-card success">
        <div class="stat-icon">✅</div>
        <div class="stat-value"><%= pumps.filter(p => p.status === 'active').length %></div>
        <div class="stat-label">Active Stations</div>
      </div>
      <div class="stat-card warning">
        <div class="stat-icon">🔧</div>
        <div class="stat-value"><%= pumps.filter(p => p.status === 'maintenance').length %></div>
        <div class="stat-label">In Maintenance</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">⛽</div>
        <div class="stat-value"><%= pumps.length %></div>
        <div class="stat-label">Total Stations</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">⛽ Your Stations</h3>
        <a href="/pump/uptime" class="btn btn-primary btn-sm">🔧 Toggle Maintenance Mode</a>
      </div>
      <% pumps.forEach(p => { %>
      <div style="display:flex; align-items:center; gap:16px; padding:16px 0; border-bottom:1px solid var(--border-color);">
        <div style="font-size:28px;"><%= p.status === 'active' ? '✅' : '🔧' %></div>
        <div style="flex:1;">
          <div class="font-bold"><%= p.name %></div>
          <div class="text-muted text-sm">📍 <%= p.location %></div>
        </div>
        <span class="badge badge-<%= p.status === 'active' ? 'success' : 'warning' %>"><%= p.status %></span>
      </div>
      <% }) %>
    </div>

  </main>
</div>
</body>
</html>
