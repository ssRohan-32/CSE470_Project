<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Login to the Fuel Station Management System">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-logo">
        <div class="emoji">⛽</div>
        <h1>FuelStation MS</h1>
        <p>Sign in to your account</p>
      </div>

      <%- include('../partials/flash') %>

      <form action="/login" method="POST" id="login-form">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input type="email" id="email" name="email" class="form-control"
                 placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control"
                 placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary w-full btn-lg" style="justify-content:center; margin-top:8px;">
          🔐 Sign In
        </button>
      </form>

      <div style="text-align:center; margin-top:24px; color: var(--text-muted); font-size:13px;">
        Don't have an account? <a href="/register">Create one</a>
      </div>

      <hr class="divider">

      <div style="font-size:11px; color:var(--text-muted);">
        <strong style="color:var(--text-secondary);">Demo Accounts:</strong>
        <table style="width:100%; margin-top:8px; border-collapse:collapse;">
          <tr><td style="padding:3px 0; color:var(--accent-primary);">Superadmin</td><td>admin@fuel.com</td><td>admin123</td></tr>
          <tr><td style="padding:3px 0; color:var(--accent-success);">Customer</td><td>alice@fuel.com</td><td>pass123</td></tr>
          <tr><td style="padding:3px 0; color:var(--accent-warning);">Pump Owner</td><td>pumpa@fuel.com</td><td>pass123</td></tr>
          <tr><td style="padding:3px 0; color:var(--accent-secondary);">Refinery</td><td>refinex@fuel.com</td><td>pass123</td></tr>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
