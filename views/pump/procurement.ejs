<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/pump/procurement' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">📦 Automated Procurement Portal</h1>
        <p class="page-subtitle">Feature 11 — Validated Bulk Fuel Requests to Government Refineries</p>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3 class="card-title">🛒 New Procurement Order</h3></div>
        <form action="/pump/procurement" method="POST" onsubmit="return validateOrder()">
          <div class="form-group">
            <label class="form-label">Select Refinery</label>
            <select name="refinery_id" class="form-control" required>
              <option value="">-- Choose Refinery --</option>
              <% refineries.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %> (<%= r.location %>) — Cap: <%= (r.capacity/1000).toFixed(0) %>kL</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Fuel Type</label>
            <select name="fuel_type" class="form-control" required>
              <% fuelTypes.forEach(f => { %><option value="<%= f %>"><%= f %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Quantity (Litres)</label>
            <input type="number" name="quantity" class="form-control" min="1000" max="500000" step="100" placeholder="10000" required id="qty-field">
            <div class="text-muted text-xs mt-4">Minimum: 1,000L | Wholesale price: ৳0.85/L</div>
          </div>
          <div class="form-group">
            <label class="form-label">Special Notes</label>
            <textarea name="notes" class="form-control" rows="2" placeholder="Urgency, special instructions..."></textarea>
          </div>
          <div id="order-preview" style="display:none;" class="alert alert-info mb-16">
            <span>💰</span>
            <div>Estimated cost: <strong id="preview-cost">৳0</strong> at ৳0.85/L wholesale price</div>
          </div>
          <button type="submit" class="btn btn-primary w-full" style="justify-content:center;">📤 Submit Order</button>
        </form>
      </div>

      <div class="card">
        <div class="card-header"><h3 class="card-title">📜 My Orders</h3></div>
        <div class="table-wrapper">
          <table>
            <thead><tr><th>Date</th><th>Fuel</th><th>Qty</th><th>Cost</th><th>Status</th></tr></thead>
            <tbody>
              <% myOrders.forEach(o => { %>
              <tr>
                <td class="text-sm text-muted"><%= new Date(o.created_at).toLocaleDateString() %></td>
                <td class="fuel-<%= o.fuel_type.toLowerCase() %>"><%= o.fuel_type %></td>
                <td><%= o.quantity.toLocaleString() %>L</td>
                <td class="font-bold">৳<%= o.total_cost.toLocaleString() %></td>
                <td><span class="badge badge-<%= o.status==='pending'?'warning':o.status==='accepted'?'success':o.status==='rejected'?'danger':'info' %>"><%= o.status %></span></td>
              </tr>
              <% }) %>
              <% if (!myOrders.length) { %><tr><td colspan="5" style="text-align:center;padding:24px;" class="text-muted">No orders yet.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>
<script>
  document.getElementById('qty-field').addEventListener('input', function() {
    const qty = parseFloat(this.value) || 0;
    const cost = (qty * 0.85).toFixed(2);
    const preview = document.getElementById('order-preview');
    const costEl = document.getElementById('preview-cost');
    if (qty >= 1000) {
      preview.style.display = 'flex';
      costEl.textContent = '৳' + parseFloat(cost).toLocaleString();
    } else {
      preview.style.display = 'none';
    }
  });

  function validateOrder() {
    const qty = parseFloat(document.getElementById('qty-field').value);
    if (qty < 1000) { alert('Minimum order quantity is 1,000 litres.'); return false; }
    return true;
  }
</script>
</body>
</html>
