<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/pump/dashboard' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>
    <div class="topbar"><div><h1 class="page-title">🏪 Pump Dashboard</h1></div></div>
    <div class="stat-grid">
      <div class="stat-card"><div class="stat-icon">🏪</div><div class="stat-value"><%= pumps.length %></div><div class="stat-label">My Stations</div></div>
      <div class="stat-card success"><div class="stat-icon">✅</div><div class="stat-value"><%= pumps.filter(p=>p.status==='active').length %></div><div class="stat-label">Active</div></div>
      <div class="stat-card warning"><div class="stat-icon">🔧</div><div class="stat-value"><%= pumps.filter(p=>p.status==='maintenance').length %></div><div class="stat-label">In Maintenance</div></div>
      <div class="stat-card"><div class="stat-icon">📋</div><div class="stat-value"><%= recentOrders.length %></div><div class="stat-label">Recent Orders</div></div>
    </div>
    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3 class="card-title">🏪 My Stations</h3><a href="/pump/uptime" class="btn btn-primary btn-sm">Manage</a></div>
        <% pumps.forEach(p => { %>
        <div style="padding:12px 0; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div class="font-semibold"><%= p.name %></div>
            <div class="text-muted text-sm">📍 <%= p.location %></div>
          </div>
          <div style="text-align:right;">
            <span class="badge badge-<%= p.status==='active'?'success':'warning' %>"><%= p.status %></span>
            <div class="text-muted text-xs mt-4">⭐ <%= p.trust_score.toFixed(1) %>/100</div>
          </div>
        </div>
        <% }) %>
      </div>
      <div class="card">
        <div class="card-header"><h3 class="card-title">📦 Recent Procurement Orders</h3><a href="/pump/procurement" class="btn btn-primary btn-sm">+ New Order</a></div>
        <% recentOrders.forEach(o => { %>
        <div style="padding:10px 0; border-bottom:1px solid var(--border-color);">
          <div class="flex-between">
            <div class="font-semibold text-sm"><%= o.fuel_type %> — <%= o.quantity.toLocaleString() %>L</div>
            <span class="badge badge-<%= o.status==='pending'?'warning':o.status==='accepted'?'success':'danger' %>"><%= o.status %></span>
          </div>
          <div class="text-muted text-xs"><%= o.refinery_name %> · ৳<%= o.total_cost.toLocaleString() %></div>
        </div>
        <% }) %>
      </div>
    </div>
  </main>
</div>
</body>
</html>
