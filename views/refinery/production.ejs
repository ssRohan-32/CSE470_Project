<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { currentPath: '/refinery/production' }) %>
  <main class="main-content animate-fade">
    <%- include('../partials/flash') %>

    <div class="topbar">
      <div>
        <h1 class="page-title">🏭 Production Analytics</h1>
        <p class="page-subtitle">Feature 17 — Monthly Fuel Production Volume Logging &amp; Analytics · <%= refinery.name %></p>
      </div>
      <button onclick="document.getElementById('log-modal').style.display='flex'" class="btn btn-primary">+ Log Production</button>
    </div>

    <!-- Fuel Type Totals -->
    <div class="stat-grid mb-24">
      <% const fuelIcons = { Octane:'🔶', Diesel:'⚫', Petrol:'🟢', EV:'⚡' }; %>
      <% if (!fuelTotals.length) { %>
      <div class="stat-card" style="grid-column:1/-1; text-align:center;">
        <div class="stat-icon">📊</div>
        <div class="stat-value" style="font-size:24px;">No data yet</div>
        <div class="stat-label">Log your first production entry to start tracking</div>
      </div>
      <% } %>
      <% fuelTotals.forEach(ft => { %>
      <div class="stat-card">
        <div class="stat-icon"><%= fuelIcons[ft.fuel_type] || '⛽' %></div>
        <div class="stat-value"><%= (ft.total_volume/1000).toFixed(1) %>k L</div>
        <div class="stat-label"><%= ft.fuel_type %> — all time</div>
        <div class="stat-note"><%= ft.entries %> log entries</div>
      </div>
      <% }) %>
    </div>

    <!-- Charts -->
    <div class="grid-2 mb-24">
      <div class="card">
        <div class="card-header"><h3 class="card-title">📈 Monthly Production Trend (12 Months)</h3></div>
        <div class="chart-container"><canvas id="trendChart"></canvas></div>
      </div>
      <div class="card">
        <div class="card-header"><h3 class="card-title">⛽ Volume by Fuel Type</h3></div>
        <div class="chart-container"><canvas id="fuelChart"></canvas></div>
      </div>
    </div>

    <!-- Monthly Breakdown Table -->
    <% if (monthlyLogs.length) { %>
    <div class="card mb-24">
      <div class="card-header">
        <h3 class="card-title">📅 Monthly Breakdown by Fuel Type</h3>
        <span class="badge badge-muted"><%= monthlyLogs.length %> entries</span>
      </div>
      <div class="table-wrapper">
        <table>
          <thead><tr><th>Month</th><th>Fuel Type</th><th>Volume (L)</th><th>Log Entries</th></tr></thead>
          <tbody>
            <% monthlyLogs.forEach(row => { %>
            <tr>
              <td class="font-semibold"><%= row.production_month %></td>
              <td><span class="fuel-<%= row.fuel_type.toLowerCase() %> font-semibold"><%= fuelIcons[row.fuel_type] || '' %> <%= row.fuel_type %></span></td>
              <td class="font-bold"><%= row.total_volume.toLocaleString() %> L</td>
              <td class="text-muted"><%= row.entries %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <!-- Recent Raw Log Entries -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">🗒️ Recent Log Entries</h3>
        <button onclick="document.getElementById('log-modal').style.display='flex'" class="btn btn-primary btn-sm">+ Add Entry</button>
      </div>
      <div class="table-wrapper">
        <table>
          <thead><tr><th>Logged At</th><th>Month</th><th>Fuel Type</th><th>Volume (L)</th><th>Notes</th></tr></thead>
          <tbody>
            <% if (!recentEntries.length) { %>
            <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted);">No entries yet. Click "+ Log Production" to get started.</td></tr>
            <% } %>
            <% recentEntries.forEach(e => { %>
            <tr>
              <td class="text-sm text-muted"><%= new Date(e.logged_at).toLocaleDateString() %></td>
              <td class="font-semibold"><%= e.production_month %></td>
              <td><span class="fuel-<%= e.fuel_type.toLowerCase() %>"><%= e.fuel_type %></span></td>
              <td class="font-bold"><%= e.volume_litres.toLocaleString() %> L</td>
              <td class="text-sm text-muted"><%= e.notes || '—' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Log Production Modal -->
    <div id="log-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.65); z-index:200; align-items:center; justify-content:center;">
      <div class="card" style="max-width:440px; width:90%;">
        <div class="card-header">
          <h3 class="card-title">🏭 Log Monthly Production</h3>
          <button onclick="document.getElementById('log-modal').style.display='none'" class="btn btn-ghost btn-sm">✕</button>
        </div>
        <form action="/refinery/production/log" method="POST">
          <div class="form-group">
            <label class="form-label">Production Month</label>
            <input type="month" name="production_month" class="form-control" value="<%= new Date().toISOString().slice(0,7) %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Fuel Type</label>
            <select name="fuel_type" class="form-control" required>
              <option>Octane</option><option>Diesel</option><option>Petrol</option><option>EV</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Volume (Litres)</label>
            <input type="number" name="volume_litres" class="form-control" min="1" step="0.01" placeholder="e.g. 50000" required>
          </div>
          <div class="form-group">
            <label class="form-label">Notes (optional)</label>
            <textarea name="notes" class="form-control" rows="2" placeholder="Maintenance shutdown, capacity expansion..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-full" style="justify-content:center;">📥 Submit Log Entry</button>
        </form>
      </div>
    </div>

  </main>
</div>

<script src="/js/charts.js"></script>
<script>
  const trend = <%- monthlyTrend %>;
  const parsed = typeof trend === 'string' ? JSON.parse(trend) : trend;

  if (parsed && parsed.length) {
    new Chart(document.getElementById('trendChart'), {
      type: 'line',
      data: {
        labels: parsed.map(r => r.production_month),
        datasets: [{
          label: 'Total Production (L)',
          data: parsed.map(r => r.total_volume),
          borderColor: '#6c63ff',
          backgroundColor: '#6c63ff22',
          fill: true, tension: 0.4, pointRadius: 5
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(255,255,255,0.03)' } } }
      }
    });
  }

  const fuelTotals = <%- JSON.stringify(fuelTotals) %>;
  if (fuelTotals && fuelTotals.length) {
    new Chart(document.getElementById('fuelChart'), {
      type: 'doughnut',
      data: {
        labels: fuelTotals.map(f => f.fuel_type),
        datasets: [{ data: fuelTotals.map(f => f.total_volume), backgroundColor: ['#ff9f43','#a29bfe','#00e5a0','#00d4ff'], borderColor: '#10141f', borderWidth: 3 }]
      },
      options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { position: 'right', labels: { padding: 16, usePointStyle: true } } } }
    });
  }
</script>
</body>
</html>
